APP_NAME="AmCore Systems"
APP_ENV=local
APP_KEY=
# Local dev only. Production MUST set APP_ENV=production and APP_DEBUG=false —
# debug mode renders full stack traces (file paths, env values, queries) to
# any visitor who triggers an error. Verify this before every deploy.
APP_DEBUG=true
APP_URL=http://amcore.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Explicit, not auto-detected — auto-detection depends on TrustProxies correctly
# recognizing X-Forwarded-Proto behind a load balancer. Both amcore.test (Herd)
# and production are HTTPS-only, so this is safe in every environment.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local dev only. Production MUST use MAIL_MAILER=ses with a verified AmCore SES identity — never ship log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@amcoresystems.com"
MAIL_FROM_NAME="${APP_NAME}"

# [PLACEHOLDER] SES credentials for AmCore's own verified sending domain (not a hub relay).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# [PLACEHOLDER] Sentry DSN — required before first production deploy.
SENTRY_LARAVEL_DSN=

# [PLACEHOLDER] Privacy-friendly analytics — provider not yet chosen. Leave both unset
# to render no analytics script at all (the safe default).
ANALYTICS_SCRIPT_URL=
ANALYTICS_DOMAIN=

VITE_APP_NAME="${APP_NAME}"
